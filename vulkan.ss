  (import (chezscheme))
  (define loader
    (let* ([mt (symbol->string (machine-type))]
           [os? (lambda (suffix)
                  (let ([n (string-length mt)] [k (string-length suffix)])
                    (and (>= n k)
                         (string=? suffix (substring mt (- n k) n)))))]
           [candidates (cond
                         [(os? "nt") '("vulkan-1.dll")]
                         [(os? "osx")
                          '("libvulkan.1.dylib"
                             "/usr/local/lib/libvulkan.1.dylib"
                             "/opt/homebrew/lib/libvulkan.1.dylib"
                             "libMoltenVK.dylib")]
                         [else '("libvulkan.so.1" "libvulkan.so")])])
      (let try ([names candidates])
        (cond
          [(null? names)
           (error 'vulkan
             "cannot load the Vulkan loader; tried"
             candidates)]
          [(guard (e [#t #f]) (load-shared-object (car names)) #t)
           (car names)]
          [else (try (cdr names))]))))
  (define-syntax define-vk-procedure
    (syntax-rules ()
      [(_ name cname args ret)
       (define name
         (if (foreign-entry? cname)
             (foreign-procedure cname args ret)
             (lambda rest
               (error 'name
                 "not exported by the Vulkan loader"
                 cname))))]))
  (define instance-proc-addr
    (foreign-procedure "vkGetInstanceProcAddr"
      (uptr utf-8)
      uptr))
  (define device-proc-addr
    (foreign-procedure "vkGetDeviceProcAddr" (uptr utf-8) uptr))
  (define-syntax define-vk-loader
    (syntax-rules ()
      [(_ name get-proc-addr cname args ret)
       (define (name handle)
         (let ([addr (get-proc-addr handle cname)])
           (and (not (zero? addr))
                (foreign-procedure addr args ret))))]))
